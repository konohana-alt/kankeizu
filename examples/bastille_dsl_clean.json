  "timeline": [
    {
      "step": "1789-07-12 12:00",
      "narrative": "ネッケル罷免の報がパリに届くと、デムーランはパレ・ロワイヤルの群衆に武器を取るよう訴えた。",
      "focus": {
        "nodeIds": [
          "desmoulins",
          "crowd"
        ],
        "zoom": 1.5
      }
    },
    {
      "step": "1789-07-14 06:00",
      "narrative": "夜明け、パリの群衆はまずアンヴァリッドへ押し寄せ、眠っていた3万丁の銃を奪い取った。だが弾薬はほとんど無かった。",
      "focus": {
        "nodeIds": [
          "crowd",
          "muskets"
        ],
        "zoom": 1.6
      }
    },
    {
      "step": "1789-07-14 10:00",
      "narrative": "残る火薬はバスティーユにあるという。900人ほどの群衆が要塞前に集まり、火薬と大砲の引き渡しを要求した。",
      "focus": {
        "nodeIds": [
          "crowd",
          "delaunay",
          "gunpowder"
        ],
        "zoom": 1.3
      }
    },
    {
      "step": "1789-07-14 12:30",
      "narrative": "交渉は決裂し、中庭になだれ込んだ群衆に向け、守備側が発砲。戦闘が始まった。",
      "focus": {
        "edgeId": "e1",
        "zoom": 1.25
      },
      "soundEffect": "medium_gunfire"
    },
    {
      "step": "1789-07-14 15:00",
      "narrative": "反乱を起こしたフランス衛兵の一団が、ユランとエリーに率いられて群衆に合流。大砲を持ち込み、門へと向けた。",
      "focus": {
        "nodeIds": [
          "hulin",
          "elie",
          "crowd"
        ],
        "zoom": 1.4
      },
      "soundEffect": "light_cannon"
    },
    {
      "step": "1789-07-14 16:30",
      "narrative": "門は大砲の砲撃に耐えられぬと悟り、ド・ローネは火薬庫を爆破すると脅すが、部下に押しとどめられた。",
      "focus": {
        "nodeId": "delaunay",
        "zoom": 1.5
      },
      "soundEffect": "heavy_cannon"
    },
    {
      "step": "1789-07-14 17:00",
      "narrative": "マイヤールが濠に渡した板を伝ってド・ローネの降伏条件を受け取り、17時頃、跳ね橋が下ろされた。",
      "focus": {
        "edgeId": "e4",
        "zoom": 1.3
      },
      "activeEdge": "e1",
      "soundEffect": "surrender"
    },
    {
      "step": "1789-07-14 18:00",
      "narrative": "群衆がなだれ込み、7人の囚人を解放。火薬と大砲を押収した。",
      "focus": {
        "nodeIds": [
          "crowd"
        ],
        "zoom": 1.5
      }
    },
    {
      "step": "1789-07-14 19:30",
      "narrative": "ド・ローネは市庁舎まで引きずられ、殴打の末に斬首された。その首は槍の先に掲げられ、街を練り歩いた。",
      "focus": {
        "edgeId": "e1",
        "zoom": 1.3
      },
      "activeEdge": "e1",
      "soundEffect": "strikethrough"
    }
  ]
